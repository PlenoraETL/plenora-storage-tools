{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.plenora.dev/storage/plenora-storage-common-v1.schema.json",
  "title": "Plenora storage shared definitions v1",
  "$defs": {
    "key": {"type": "string", "minLength": 1, "maxLength": 4096},
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "size", "last_modified", "etag", "version"],
      "properties": {
        "key": {"$ref": "#/$defs/key"},
        "size": {"type": "integer", "minimum": 0},
        "last_modified": {"type": ["string", "null"], "format": "date-time"},
        "etag": {"type": ["string", "null"]},
        "version": {"type": ["string", "null"]}
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "transfer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "bytes_transferred", "checksum", "etag", "version"],
      "properties": {
        "key": {"$ref": "#/$defs/key"},
        "bytes_transferred": {"type": "integer", "minimum": 0},
        "checksum": {"$ref": "#/$defs/integrity"},
        "etag": {"type": ["string", "null"]},
        "version": {"type": ["string", "null"]}
      }
    }
  }
}
