{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.plenora.dev/storage/plenora-storage-list-output-v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["objects", "truncated", "next_cursor"],
  "properties": {
    "objects": {"type": "array", "items": {"$ref": "plenora-storage-common-v1.schema.json#/$defs/object"}},
    "truncated": {"type": "boolean"},
    "next_cursor": {
      "type": ["string", "null"],
      "maxLength": 512,
      "pattern": "^cursor://[0-9a-f]{64}$"
    }
  }
}
