{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.plenora.dev/storage/plenora-storage-webdav-connection-v1.schema.json",
  "title": "Plenora webdav configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "endpoint"
  ],
  "properties": {
    "endpoint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "format": "uri",
      "pattern": "/$"
    }
  }
}
