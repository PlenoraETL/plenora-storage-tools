{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.plenora.dev/storage/plenora-storage-smb-connection-v1.schema.json",
  "title": "Plenora smb configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "host",
    "share"
  ],
  "properties": {
    "host": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "default": 445
    },
    "share": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "root": {
      "type": "string",
      "minLength": 0,
      "maxLength": 4096,
      "default": ""
    }
  }
}
