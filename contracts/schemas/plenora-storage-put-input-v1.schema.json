{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.plenora.dev/storage/plenora-storage-put-input-v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "connection", "key", "artifact_source", "overwrite", "publication_policy"],
  "properties": {
    "schema_version": {"const": 1},
    "connection": {"$ref": "plenora-storage-connection-v1.schema.json"},
    "key": {"$ref": "plenora-storage-common-v1.schema.json#/$defs/key"},
    "artifact_source": {
      "$ref": "plenora-storage-common-v1.schema.json#/$defs/artifactReference"
    },
    "overwrite": {"type": "boolean"},
    "publication_policy": {"enum": ["best_effort", "atomic_required"]},
    "content_type": {"type": ["string", "null"], "maxLength": 255},
    "content_length": {"type": ["integer", "null"], "minimum": 0},
    "metadata": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {"maxLength": 128},
      "additionalProperties": {"type": "string", "maxLength": 2048}
    }
  }
}
