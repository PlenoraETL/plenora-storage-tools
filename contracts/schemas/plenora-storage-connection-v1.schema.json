{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.plenora.dev/storage/plenora-storage-connection-v1.schema.json",
  "title": "Plenora storage provider connection v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider", "config_contract", "config", "credential_ref"],
  "properties": {
    "provider": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "config_contract": {"type": "string", "pattern": "^plenora-[a-z0-9-]+-v[1-9][0-9]*$"},
    "config": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "not": {
          "pattern": "(^|_)([Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Pp][Aa][Ss][Ss][Ww][Dd]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll][Ss]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Aa][Pp][Ii]_[Kk][Ee][Yy]|[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee]_[Kk][Ee][Yy]|[Aa][Cc][Cc][Ee][Ss][Ss]_[Kk][Ee][Yy]|[Ss][Ee][Cc][Rr][Ee][Tt]_[Kk][Ee][Yy])($|_)"
        }
      }
    },
    "credential_ref": {
      "type": "string",
      "minLength": 5,
      "maxLength": 512,
      "pattern": "^[a-z][a-z0-9+.-]{1,31}:(//)?[^\\s\\\\]+$"
    }
  }
}
