* text=auto
.gitattributes text eol=lf

*.rs text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.pyi text eol=lf
LICENSE text eol=lf
LICENSE-* text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.json text eol=lf
*.md text eol=lf
api/**/*.txt text eol=lf
scripts/requirements-*.txt text eol=lf
Dockerfile text eol=lf
# SMB2, DER, NTLM and Kerberos seeds are wire bytes, not text.
fuzz/seeds/smb2_messages/** binary
fuzz/seeds/spnego_der/** binary
fuzz/seeds/ntlm_challenge/** binary
fuzz/seeds/kerberos_messages/** binary
